# Copy to .env (which is git-ignored) before running docker compose.
# These values are read by docker-compose.yml.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=inventory

# Origins allowed to call the backend (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# Backend URL the frontend is built against (browser -> backend).
VITE_API_URL=http://localhost:8000
